[core]
dags_folder = @DAGS_FOLDER@
executor = LocalExecutor
load_examples = False
fernet_key = @FERNET_KEY@
execution_api_server_url = http://127.0.0.1:8791/execution
# One operator SSO: the package-local Feishu auth manager. Its FEISHU_* settings come from the
# private environment file referenced by the api-server unit; with none supplied it fails
# explicitly (no password login and no fallback).
auth_manager = description_pipeline.orchestration.feishu_auth.FeishuAuthManager
[database]
sql_alchemy_conn = @AIRFLOW_DB_URL@
[logging]
base_log_folder = @AIRFLOW_HOME@/logs
logging_level = INFO
# nginx owns HTTP access logging (URI-only); drop the API server's INFO access
# records so query values (OAuth code/state) never reach the journal.
namespace_levels = http.access=WARNING
[api]
expose_config = False
[api_auth]
jwt_secret = @JWT_SECRET@
