# User-level nginx configuration for the single authenticated operator URL.
# Renderer: deploy/operator/render_operator.py (do not edit in place).
worker_processes 1;
daemon off;
pid @OPERATOR_STATE@/nginx/nginx.pid;
error_log @OPERATOR_STATE@/nginx/error.log warn;

events {
    worker_connections 256;
}

http {
    # Access logs stay URI-only: OAuth code/state values never reach a log file.
    log_format operator_uri_only '$remote_addr - $remote_user [$time_local] '
                                 '"$request_method $uri $server_protocol" $status $body_bytes_sent';
    access_log @OPERATOR_STATE@/nginx/access.log operator_uri_only;
    client_body_temp_path @OPERATOR_STATE@/nginx/tmp/body;
    proxy_temp_path @OPERATOR_STATE@/nginx/tmp/proxy;
    fastcgi_temp_path @OPERATOR_STATE@/nginx/tmp/fastcgi;
    uwsgi_temp_path @OPERATOR_STATE@/nginx/tmp/uwsgi;
    scgi_temp_path @OPERATOR_STATE@/nginx/tmp/scgi;
    # Folder uploads stream through the portal. The portal's own Content-Length admission bound
    # (2 GiB of file bytes + multipart framing allowance) sits just below this nginx envelope.
    client_max_body_size 2112m;
    client_body_timeout 600s;
    server_tokens off;

    server {
        listen @OPERATOR_BIND@:@OPERATOR_HTTPS_PORT@ ssl;
        server_name @OPERATOR_HOST@;

        ssl_certificate @OPERATOR_TLS_CERT@;
        ssl_certificate_key @OPERATOR_TLS_KEY@;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 10m;

        location = /operator-healthz {
            access_log off;
            return 200 "ok\n";
        }

        # Canonical origin: the login must move to the canonical origin BEFORE any state cookie
        # is minted, and a callback arriving on another origin (corporate entry) is sent to the
        # canonical callback with its query preserved. Requests on the canonical host proxy on.
        location = /auth/feishu/login {
            if ($host != "@OPERATOR_HOST@") {
                return 302 https://@OPERATOR_HOST@:@OPERATOR_HTTPS_PORT@/auth/feishu/login;
            }
            proxy_pass http://127.0.0.1:8791;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location = /auth/feishu/callback {
            if ($host != "@OPERATOR_HOST@") {
                return 302 https://@OPERATOR_HOST@:@OPERATOR_HTTPS_PORT@$uri$is_args$args;
            }
            proxy_pass http://127.0.0.1:8791;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Feishu SSO callback goes to the Airflow api-server; the operator page stays on the portal.
        location ^~ /auth/feishu/ {
            proxy_pass http://127.0.0.1:8791;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Streaming folder upload: Content-Length required, no request buffering for multi-GB bodies.
        location ^~ /api/runs {
            proxy_pass http://@OPERATOR_UPSTREAM@;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_request_buffering off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        location / {
            proxy_pass http://@OPERATOR_UPSTREAM@;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
        }
    }
}
