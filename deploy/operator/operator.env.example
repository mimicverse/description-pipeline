# Operator deployment configuration for the one supported Linux deployment (Release 1.0):
# Ubuntu 22.04 x86_64, PostgreSQL 14 packages, user-level nginx-core and the pinned
# uv 0.12.23 / CPython 3.12.14 toolchain installed by `install`.
#
#   deploy/operator/operatorctl.sh install --env-file <this file>   # owns every write below
#   deploy/operator/operatorctl.sh start|stop|status|health --env-file <this file>
#
# `install` renders the current configuration, TLS material and service units. start/stop/status/
# health never rewrite configuration: they load the installed configuration and report drift;
# start/stop only change service state. Keep this file and OPERATOR_STATE outside Git (mode 0600).
#
# Public identity of the single operator URL: a DNS name or LAN address.
OPERATOR_HOST=robot.example.lan
# Bind address for the reverse proxy (0.0.0.0 exposes the LAN URL; 127.0.0.1 keeps it local).
OPERATOR_BIND=0.0.0.0
# HTTPS port. 443 requires a privileged setup; the supported layout uses a high user-level port.
OPERATOR_HTTPS_PORT=8443

# All state, secrets and logs live here (0700). Keep it outside the Git checkout.
OPERATOR_STATE=/home/andy/operator/state
# Portal upstream socket (loopback only).
OPERATOR_UPSTREAM=127.0.0.1:8788

# Authentication: one Feishu SSO login for the whole deployment, handled by the package-local
# Airflow auth manager (rendered into $OPERATOR_STATE/feishu.env, 0600, loaded only by the
# api-server unit). There is no local password account, no second login at the proxy and no
# fallback: without the app credentials below, login fails explicitly.
# Optional externally issued certificate/key; when empty a self-signed certificate is generated
# with a subjectAltName for OPERATOR_HOST (LAN rehearsal). Replace for a public domain.
OPERATOR_TLS_CERT=
OPERATOR_TLS_KEY=
OPERATOR_TLS_DAYS=825

# Feishu SSO app credentials (enterprise app; keep every value outside Git). Provide the secret
# file and the tenant allowlist together; the optional admin list never implies membership.
# 0600 JSON file: {"app_id": "...", "app_secret": "..."}; the app_id stays out of the environment.
FEISHU_APP_SECRET_FILE=
# Comma-separated tenant_key allowlist, without spaces; listed tenants may log in.
FEISHU_TENANT_KEYS=
# Optional admin open_ids, comma-separated without spaces; each must belong to a listed tenant.
FEISHU_ADMIN_OPEN_IDS=

# Airflow runtime (see deploy/airflow/install.sh). Absolute, private, distinct paths.
AIRFLOW_VENV=/home/andy/operator/airflow-venv
AIRFLOW_HOME=/home/andy/operator/airflow-home
# Release wheel matching the Windows worker.
PIPELINE_WHEEL=/home/andy/operator/wheels/mimicverse_description-1.0.1-py3-none-any.whl
POSTGRES_ROOT=/home/andy/operator/airflow-pg
POSTGRES_MAJOR=14
AIRFLOW_DB_URL=postgresql+psycopg2://solidworks@/airflow_meta?host=/home/andy/operator/airflow-pg/socket&port=5433
# SSH host alias for the Windows SolidWorks endpoint tunnel. Required: authenticated loopback HTTP
# through this tunnel is the one supported transport for the native endpoint.
SOLIDWORKS_SSH_HOST=windows-m3
# Loopback port the Windows endpoint listens on.
SOLIDWORKS_ENDPOINT_PORT=8765

# Portal: one fixed entry, rendered from this file on every install.
#   $AIRFLOW_VENV/bin/python -m description_pipeline.orchestration.portal --config <OPERATOR_STATE>/portal.json
# The portal config schema is exact and rejects unknown keys:
#   {"airflow":{"url"},"endpoint":{"url","token_file"},"portal":{"host","port"}}
# Bearer token file for the tunneled Windows endpoint (0600, outside Git).
ENDPOINT_TOKEN_FILE=/home/andy/operator/secrets/endpoint.token
# One dedicated Linux CAD intake directory: absolute, narrow and outside the deployment runtime
# and state (never an OS/home/runtime/state root). install creates it 0700 and writes it into the
# solidworks_windows connection extra as handoff_roots, the shared client's allowlist. It is not
# repeated in portal.json.
SOLIDWORKS_HANDOFF_ROOT=/home/andy/cad-handoffs

# nginx binary used for the user-level reverse proxy.
NGINX_BIN=/usr/sbin/nginx
