# Keep repository editor settings aligned with ruff format (ruff.toml).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{json,toml,yaml,yml,ps1}]
indent_style = space
indent_size = 2

[*.md]
# Preserve the two trailing spaces used for Markdown hard line breaks.
trim_trailing_whitespace = false
