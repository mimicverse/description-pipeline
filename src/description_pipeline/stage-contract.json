{
  "schema_version": "solidworks-to-urdf.stage-contract/v1",
  "pipeline_id": "solidworks-to-urdf",
  "stages": [
    {
      "id": "freeze",
      "host": "native",
      "name": "Freeze inputs",
      "name_zh": "冻结输入",
      "inputs": [
        {
          "label": "Saved SolidWorks folder",
          "path": "handoff/",
          "class": "native"
        }
      ],
      "input_qc": [
        {
          "id": "handoff.admission",
          "label": "Admitted path, regular files and native package"
        }
      ],
      "outputs": [
        {
          "label": "Frozen handoff, file inventory and digest",
          "path": "handoff/",
          "class": "frozen"
        }
      ],
      "output_qc": [
        {
          "id": "handoff.integrity",
          "label": "Exact file inventory and handoff digest"
        }
      ],
      "evidence": [
        "handoff_sha256",
        "package_files"
      ]
    },
    {
      "id": "discover",
      "host": "native",
      "name": "Discover structure",
      "name_zh": "解析结构",
      "inputs": [
        {
          "label": "Frozen handoff and versioned component records",
          "path": "handoff/",
          "class": "frozen"
        }
      ],
      "input_qc": [
        {
          "id": "discovery.inputs",
          "label": "Unchanged handoff and controlled discovery settings"
        }
      ],
      "outputs": [
        {
          "label": "Native observations and findings",
          "path": "input/discovery/",
          "class": "frozen"
        },
        {
          "label": "Derived definition and structural revision",
          "path": "input/robot.yaml + input/cad-revision.json",
          "class": "derived"
        }
      ],
      "output_qc": [
        {
          "id": "discovery.definition",
          "label": "Unambiguous identity, bodies, motion, names and references"
        },
        {
          "id": "discovery.binding",
          "label": "Native evidence, original files, revision and routing agree"
        }
      ],
      "evidence": [
        "input/discovery/native-discovery.json",
        "input/robot.yaml",
        "input/cad-revision.json"
      ]
    },
    {
      "id": "capture",
      "host": "native",
      "name": "Capture evidence",
      "name_zh": "采集证据",
      "inputs": [
        {
          "label": "Prepared definition, saved CAD and native runtime",
          "path": "input/",
          "class": "prepared"
        }
      ],
      "input_qc": [
        {
          "id": "input.valid",
          "label": "Derived definition, structural revision and archive integrity"
        },
        {
          "id": "runtime.ready",
          "label": "Native Windows, COM and SolidWorks prerequisites"
        }
      ],
      "outputs": [
        {
          "label": "Collected CAD, raw measurements, native meshes and manifest",
          "path": "evidence/",
          "class": "frozen"
        }
      ],
      "output_qc": [
        {
          "id": "capture.integrity",
          "label": "Complete snapshot with capture and saved-state guards"
        },
        {
          "id": "capture.input_stability",
          "label": "Original handoff unchanged after capture"
        }
      ],
      "evidence": [
        "reports/input.json",
        "evidence/manifest.json",
        "evidence/raw/",
        "evidence/source/"
      ]
    },
    {
      "id": "generate",
      "host": "portable",
      "name": "Generate URDF",
      "name_zh": "生成 URDF",
      "inputs": [
        {
          "label": "Frozen native evidence",
          "path": "evidence/",
          "class": "frozen"
        }
      ],
      "input_qc": [
        {
          "id": "generation.inputs",
          "label": "Snapshot integrity before consumption"
        }
      ],
      "outputs": [
        {
          "label": "Canonical model",
          "path": "model/robot.json",
          "class": "derived"
        },
        {
          "label": "URDF and local meshes",
          "path": "urdf/ + meshes/",
          "class": "derived"
        },
        {
          "label": "Tool identity and file subject",
          "path": "reports/tool.json",
          "class": "derived"
        }
      ],
      "output_qc": [
        {
          "id": "generation.artifacts",
          "label": "Valid canonical schema and complete hashed delivery"
        }
      ],
      "evidence": [
        "model/robot.json",
        "urdf/robot.urdf",
        "meshes/",
        "reports/tool.json"
      ]
    },
    {
      "id": "verify",
      "host": "portable",
      "name": "Independent verification",
      "name_zh": "独立验证",
      "inputs": [
        {
          "label": "Original evidence and actual generated files",
          "path": "input/ + evidence/ + model/ + urdf/ + meshes/",
          "class": "bound"
        }
      ],
      "input_qc": [
        {
          "id": "verification.subject",
          "label": "Generated file subject unchanged"
        }
      ],
      "outputs": [
        {
          "label": "Deterministic per-object quality report",
          "path": "reports/quality.json",
          "class": "derived"
        }
      ],
      "output_qc": [
        {
          "id": "verification.gates",
          "label": "All required native, physical, frame, geometry and consumer checks"
        },
        {
          "id": "verification.report_binding",
          "label": "Saved report equals independent recomputation"
        }
      ],
      "evidence": [
        "reports/quality.json",
        "subject_sha256"
      ]
    },
    {
      "id": "publish",
      "host": "portable",
      "name": "Publish review PR",
      "name_zh": "提交评审 PR",
      "inputs": [
        {
          "label": "Verified delivery and configured model repository",
          "path": "urdf/ + meshes/ + reports/quality.json",
          "class": "verified"
        }
      ],
      "input_qc": [
        {
          "id": "publication.inputs",
          "label": "Reverified delivery, clean repository and deterministic review branch"
        }
      ],
      "outputs": [
        {
          "label": "Candidate commit and PR receipt",
          "path": "reports/pr.json",
          "class": "receipt"
        }
      ],
      "output_qc": [
        {
          "id": "publication.git",
          "label": "Copied, staged and committed bytes match the verified subject"
        },
        {
          "id": "publication.receipt",
          "label": "Remote commit, PR head/base and subject agree"
        }
      ],
      "evidence": [
        "reports/pr.json",
        "commit",
        "url"
      ]
    }
  ],
  "confirmations": [
    {
      "id": "design_fidelity",
      "label": "设计与实物对应",
      "reference": "docs/mechanical-handoff-spec.md#111-自动检查与工程师确认",
      "review_stage": "discover",
      "scope": "确认本版 CAD 的配置、附件和机构符合预期实物；确认接口名称与实物身份、跨版本改名对应关系、轴线原点与偏置、机械零位和正向；确认设计表、方程及上下文引用表达正确设计意图。",
      "automatic_exclusion": "不重复检查主装配唯一性、实例覆盖、刚体唯一归属、树拓扑、坐标变换或导出一致性。"
    },
    {
      "id": "motion_safety",
      "label": "全行程与装配安全",
      "reference": "docs/mechanical-handoff-spec.md#111-自动检查与工程师确认",
      "review_stage": "verify",
      "scope": "确认全行程及关键组合姿态的干涉、间隙、公差、止挡、安全余量和线缆约束；保留设计接触等例外依据。",
      "automatic_exclusion": "不重复检查限位数值合法性、原生限位与输出限位的一致性。"
    },
    {
      "id": "drive_applicability",
      "label": "驱动工况适用性",
      "reference": "docs/mechanical-handoff-spec.md#111-自动检查与工程师确认",
      "review_stage": "discover",
      "scope": "确认受控驱动规格适用于实际型号、传动、输出侧、负载及持续／峰值工况。",
      "automatic_exclusion": "不重复抄录或核算流水线已验证的规格引用、版本、数值和派生一致性。"
    },
    {
      "id": "physical_fidelity",
      "label": "物理参数真实性",
      "reference": "docs/mechanical-handoff-spec.md#111-自动检查与工程师确认",
      "review_stage": "capture",
      "scope": "确认实际材料、密度、质量边界和简化假设符合实物，覆盖值或实测参数具有可信来源。",
      "automatic_exclusion": "不重复验算 CAD 与 URDF 总质量、质心、惯量组合、单位和变换。"
    },
    {
      "id": "acceptance_basis",
      "label": "独立验收依据",
      "reference": "docs/mechanical-handoff-spec.md#111-自动检查与工程师确认",
      "review_stage": "verify",
      "scope": "确认质量及外形验收区间来自独立设计预算、受控规格或实测，并适用于本版配置和不确定度。",
      "automatic_exclusion": "不重复比较产物是否落在已声明区间内。"
    }
  ],
  "unsupported": [
    {
      "id": "interference",
      "label": "干涉与间隙：全行程干涉、碰撞及制造公差验算",
      "stage": "verify"
    },
    {
      "id": "naming_identity",
      "label": "命名与身份：术语与物料号身份绑定、跨版本改名对应关系",
      "stage": "discover"
    }
  ]
}
