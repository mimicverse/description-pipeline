              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "mesh"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "filename",
                      "scale"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "box"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "size"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "sphere"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "radius"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "cylinder"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "radius",
                      "length"
                    ]
