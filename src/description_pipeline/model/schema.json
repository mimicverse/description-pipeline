                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "box"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "size"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "sphere"
                      }
