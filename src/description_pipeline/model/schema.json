                    },
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "inertia": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 6,
                    "maxItems": 6
                  }
                },
                "required": [
                  "mass",
                  "xyz",
                  "rpy",
                  "inertia"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
